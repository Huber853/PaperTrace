# PaperTrace 后端环境变量模板
# 用法：把这个文件复制成 .env，然后填上你自己的 key
#   cp .env.example .env
#
# 注意：.env 文件已经在 .gitignore 中，绝对不要把它提交到 git！

# DeepSeek API 密钥（去 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# DeepSeek API base URL（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型名（deepseek-chat = 通用对话模型，deepseek-reasoner = 推理模型）
DEEPSEEK_MODEL=deepseek-chat

# ================ 仅部署时需要 ================
#
# 前端部署后的域名（多个用英文逗号分隔），用来允许 CORS。
# 本地开发不用配，已经默认放行 localhost:3000。
# 部署到 Vercel 后，把这里改成你的 Vercel 域名。
# FRONTEND_ORIGIN=https://papertrace.vercel.app
#
# 数据库连接串（默认 sqlite:///backend/papertrace.db，本地开发不用改）。
# Render 上挂了持久盘的话，改成 sqlite:////var/data/papertrace.db
# 注意：sqlite 后面是 4 个斜杠（前 3 个是协议，第 4 个是路径绝对路径的根）
# DATABASE_URL=sqlite:////var/data/papertrace.db
