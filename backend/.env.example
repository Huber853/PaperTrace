# PaperTrace 后端环境变量模板
# 用法：把这个文件复制成 .env，然后填上你自己的 key
#   cp .env.example .env
#
# 注意：.env 文件已经在 .gitignore 中，绝对不要把它提交到 git！

# DeepSeek API 密钥（去 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# DeepSeek API base URL（一般不用改）
DEEPSEEK_BASE_URL=https://api.deepseek.com

# 使用的模型名（deepseek-chat = 通用对话模型，deepseek-reasoner = 推理模型）
DEEPSEEK_MODEL=deepseek-chat
