# Required for live Agent runs
DEEPSEEK_API_KEY=replace-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Local default; Render injects a PostgreSQL connection string
DATABASE_URL=sqlite:///papertrace.db

# Keep true for one-process local development. Production uses a dedicated worker.
AGENT_EMBEDDED_WORKER=true
AGENT_WORKER_POLL_SECONDS=1
AGENT_SCHEMA_WAIT_SECONDS=120

# Comma-separated frontend origins are supported
FRONTEND_ORIGIN=http://localhost:3000

# Optional source and relation tuning
OPENALEX_EMAIL=anonymous@papertrace.local
RELATION_CONCURRENCY=8
RELATION_BATCH_SIZE=6
RELATION_CACHE_PERSIST=true
